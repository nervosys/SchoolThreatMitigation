{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "17.0"
    },
    "public_release": {
      "const": true
    },
    "deployment_certified": {
      "const": false
    },
    "scenarios": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$"
          },
          "threat": {
            "type": "string",
            "minLength": 1
          },
          "classification": {
            "type": "string",
            "minLength": 1
          },
          "observable_signal": {
            "type": "string",
            "minLength": 1
          },
          "objective": {
            "type": "string",
            "minLength": 1
          },
          "countermeasure": {
            "type": "string",
            "minLength": 1
          },
          "owner": {
            "type": "string",
            "minLength": 1
          },
          "verification_method": {
            "type": "string",
            "minLength": 1
          },
          "metric": {
            "type": "string",
            "minLength": 1
          },
          "evidence_label": {
            "type": "string",
            "minLength": 1
          },
          "rights_gate": {
            "type": "string",
            "minLength": 1
          },
          "stop_condition": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "threat",
          "classification",
          "observable_signal",
          "objective",
          "countermeasure",
          "owner",
          "verification_method",
          "metric",
          "evidence_label",
          "rights_gate",
          "stop_condition"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "version",
    "public_release",
    "deployment_certified",
    "scenarios"
  ],
  "additionalProperties": false
}
