{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "kb_version": {
      "const": "17.0-NSAI.4"
    },
    "review_status": {
      "const": "draft_independent_review_pending"
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "fact": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,79}$"
          },
          "true_means": {
            "type": "string",
            "minLength": 1
          },
          "false_means": {
            "type": "string",
            "minLength": 1
          },
          "evidence_required": {
            "type": "string",
            "minLength": 1
          },
          "rule_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          }
        },
        "required": [
          "fact",
          "true_means",
          "false_means",
          "evidence_required",
          "rule_refs",
          "source_refs"
        ]
      },
      "minItems": 1
    }
  },
  "required": [
    "schema_version",
    "kb_version",
    "review_status",
    "facts"
  ]
}
