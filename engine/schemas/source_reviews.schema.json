{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "2.0"
    },
    "kb_version": {
      "const": "17.0-NSAI.4"
    },
    "policy": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_id": {
            "type": "string",
            "pattern": "^[A-Z0-9-]+$"
          },
          "status": {
            "enum": [
              "unreviewed",
              "reviewed",
              "conflict",
              "withdrawn"
            ]
          },
          "reviewed_on": {
            "type": [
              "string",
              "null"
            ]
          },
          "valid_through": {
            "type": [
              "string",
              "null"
            ]
          },
          "evidence_locator": {
            "type": "string",
            "minLength": 1
          },
          "review_note": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "source_id",
          "status",
          "reviewed_on",
          "valid_through",
          "evidence_locator",
          "review_note"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "kb_version",
    "policy",
    "sources"
  ]
}
