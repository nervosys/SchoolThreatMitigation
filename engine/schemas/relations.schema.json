{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "const": "17.0-NSAI.4"
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "from": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$"
          },
          "to": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$"
          },
          "relation": {
            "enum": [
              "mitigated_by",
              "governed_by"
            ]
          },
          "basis": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "from",
          "to",
          "relation",
          "basis"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "version",
    "edges"
  ],
  "additionalProperties": false
}
