{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "retrieved": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,64}$"
          },
          "title": {
            "type": "string",
            "minLength": 1
          },
          "interpretation": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://[^ /]+/.+"
          }
        },
        "required": [
          "id",
          "title",
          "interpretation",
          "url"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "retrieved",
    "sources"
  ],
  "additionalProperties": false
}
